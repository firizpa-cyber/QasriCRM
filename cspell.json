{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/master/cspell.schema.json",
  "version": "0.2",
  "language": "en,ru",
  "import": ["@cspell/dict-ru_ru/cspell-ext.json"],
  "dictionaries": ["en_US", "ru_ru", "typescript", "node", "html", "css", "npm", "bash", "softwareTerms"],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".angular/**",
    "package-lock.json",
    "*.log",
    ".git/**",
    "tmp/**",
    "scripts/**"
  ],
  "words": [
    "qasri",
    "crm",
    "firuzyusupov",
    "signalr",
    "polymorpheus",
    "highlightjs",
    "wicg",
    "nerdbank",
    "gitversioning",
    "nbgv",
    "ngsw",
    "TSES",
    "autocompletions",
    "taiga",
    "zod",
    "stylelint",
    "commitlint",
    "cspell",
    "prettierrc",
    "postcssrc",
    "editorconfig",
    "angular",
    "devkit",
    "schematics",
    "swc",
    "tslib",
    "dompurify",
    "cropperjs",
    "lodash",
    "rxjs",
    "недвижимость",
    "бюджет",
    "планировка",
    "броми",
    "сделки"
  ]
}
